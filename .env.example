# =============================================================================
# GSE Router — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.
# =============================================================================

# --- NCBI API Key (REQUIRED for production use) ---
# NCBI E-utilities rate limits: 3 req/s without key, 10 req/s with key.
# Register at: https://www.ncbi.nlm.nih.gov/account/
# Without a key, large datasets (500+ samples) will hit rate limits.
NCBI_API_KEY=

# --- NCBI Contact Email (recommended) ---
# NCBI asks users to provide an email so they can contact you if there's
# an issue with your automated queries. Provide your institutional email.
NCBI_EMAIL=

# --- DeepSeek API Key (for LLM condition inference) ---
# Optional. Powers automatic control/treatment classification via LLM.
# Without this, condition inference falls back to GEO metadata only.
# Register at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# --- Data Directories ---
# Where to store downloaded GEO datasets (default: ./data)
GSE_ROUTER_DATA_DIR=./data

# Where to store pipeline outputs (default: ./output)
GSE_ROUTER_OUTPUT_DIR=./output

# --- Pipeline Behavior ---
# Auto-download supplementary files from GEO FTP (default: false)
GSE_ROUTER_AUTO_DOWNLOAD=false

# Maximum file size to download in MB (default: 500)
GSE_ROUTER_MAX_DOWNLOAD_SIZE_MB=500

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
GSE_ROUTER_LOG_LEVEL=INFO
